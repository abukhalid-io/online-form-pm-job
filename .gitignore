# Kredensial - repo ini publik, jangan pernah commit rahasia.
# GOOGLE_PRIVATE_KEY service account ada di .env.local; kalau bocor, siapa pun
# bisa baca/tulis spreadsheet PM.
.env
.env.*
!.env*.example
service-account*.json
*-credentials.json

# Dependencies
node_modules/

# clasp - .clasp.json berisi Script ID (config lokal, bukan rahasia tapi
# tidak perlu ikut repo); token OAuth clasp disimpan terpisah di home dir.
# Code.js: nama file yang dipakai clasp untuk representasi lokal Code.gs kalau
# ditarik pakai `clasp pull`/`clone` tanpa .claspignore yang benar - Code.gs
# tetap satu-satunya sumber kebenaran, Code.js dibuang setiap kali muncul.
.clasp.json
.clasprc.json
Code.js

# Next.js / Vercel
.next/
out/
build/
.vercel/

# Log & cache
*.log
npm-debug.log*
.eslintcache

# OS
.DS_Store
Thumbs.db
desktop.ini
